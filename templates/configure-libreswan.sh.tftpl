#!/bin/bash
set -euo pipefail

# Generated by Terraform and executed once via AWS Systems Manager Association.
# No PSK is embedded in this document; fetch it from encrypted Parameter Store.
dnf install -y libreswan

T1_PSK="$(aws ssm get-parameter --region '${region}' --name '${tunnel1_psk_ssm}' --with-decryption --query 'Parameter.Value' --output text)"
T2_PSK="$(aws ssm get-parameter --region '${region}' --name '${tunnel2_psk_ssm}' --with-decryption --query 'Parameter.Value' --output text)"
test -n "$T1_PSK"
test -n "$T2_PSK"

install -d -m 700 /etc/ipsec.d

# Amazon Linux normally includes these directives, but ensure consistency.
if ! grep -qE '^[[:space:]]*include[[:space:]]+/etc/ipsec.d/\*\.conf' /etc/ipsec.conf; then
  printf '\ninclude /etc/ipsec.d/*.conf\n' >> /etc/ipsec.conf
fi
if ! grep -qE '^[[:space:]]*include[[:space:]]+/etc/ipsec.d/\*\.secrets' /etc/ipsec.secrets; then
  printf '\ninclude /etc/ipsec.d/*.secrets\n' >> /etc/ipsec.secrets
fi

cat > /etc/ipsec.d/hybrid-vpn.conf <<'IPSEC'
conn aws-tunnel1
    type=tunnel
    authby=secret
    ikev2=insist
    auto=start
    left=%defaultroute
    leftid=${router_eip}
    leftsubnet=${onprem_cidr}
    right=${tunnel1_ip}
    rightsubnet=${cloud_cidr}
    ike=aes256-sha2_256;dh14
    esp=aes256-sha2_256;dh14
    ikelifetime=8h
    salifetime=1h
    dpddelay=10
    dpdtimeout=30
    dpdaction=restart

conn aws-tunnel2
    type=tunnel
    authby=secret
    ikev2=insist
    auto=add
    left=%defaultroute
    leftid=${router_eip}
    leftsubnet=${onprem_cidr}
    right=${tunnel2_ip}
    rightsubnet=${cloud_cidr}
    ike=aes256-sha2_256;dh14
    esp=aes256-sha2_256;dh14
    ikelifetime=8h
    salifetime=1h
    dpddelay=10
    dpdtimeout=30
    dpdaction=restart
IPSEC

# Only root can read PSKs. Never print them in logs or SSM output.
umask 077
printf '%s %s : PSK "%s"\n' '${router_eip}' '${tunnel1_ip}' "$T1_PSK" > /etc/ipsec.d/hybrid-vpn.secrets
printf '%s %s : PSK "%s"\n' '${router_eip}' '${tunnel2_ip}' "$T2_PSK" >> /etc/ipsec.d/hybrid-vpn.secrets
chmod 600 /etc/ipsec.d/hybrid-vpn.secrets
unset T1_PSK T2_PSK

systemctl enable ipsec
systemctl restart ipsec

# Verify process/config only; tunnel negotiation may complete shortly after.
systemctl --no-pager --full status ipsec || true
ipsec status || true
